ir_version: 8
producer_name: "pytorch"
producer_version: "2.4.1"
model_version: 0
graph {
  name: "main_graph"
  node {
    input: "x"
    input: "weight"
    input: "bias"
    output: "x_out"
    name: "/Gemm"
    op_type: "Gemm"
    attribute {
      name: "alpha"
      type: FLOAT
      f: 1
    }
    attribute {
      name: "beta"
      type: FLOAT
      f: 1
    }
    attribute {
      name: "transB"
      type: INT
      i: 1
    }
  }
  initializer {
      dims: 64
      dims: 256
      data_type: 1
      name: "weight"
  }
  initializer {
      dims: 64
      data_type: 1
      name: "bias"
  }
  input {
    name: "x"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_param: "n"
          }
          dim {
            dim_value: 256
          }
        }
      }
    }
  }
  output {
    name: "x_out"
    type {
      tensor_type {
        elem_type: 1
        shape {
          dim {
            dim_param: "n"
          }
          dim {
            dim_value: 64
          }
        }
      }
    }
  }
}
opset_import {
  domain: ""
  version: 17
}
